# effects

```
update_list = {
	for_each_loop = {
		array = global.yt_channels
		value = vv
		index = ii

		add_to_variable = { global.followers@vv = global.monthly_change@vv }
		set_variable = { global.last_position@vv = ii }
	}
	for_each_loop = {
		array = global.yt_channels
		value = vv

		set_temp_variable = { iii = 0 }
		while_loop_effect = {
			limit = {
				set_temp_variable = { channel_temp = global.yt_channels_temp^iii }
				check_variable = { global.followers@channel_temp > global.followers@vv }
			}
			add_to_temp_variable = { iii = 1 }
		}
		add_to_array = {
			array = global.yt_channels_temp
			value = vv
			position = iii
		}
	}
	clear_array = global.yt_channels
	for_each_loop = {
		array = global.yt_channels_temp
		value = vv
		
		add_to_array = { global.yt_channels = vv }
	}
	clear_array = global.yt_channels_temp
	
}

```

